{
  "name": "promo-veterinarias",
  "version": "1.0.0",
  "private": true,
  "description": "Video promocional vertical (Remotion) para vender landings a veterinarias y pet shops",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion render PromoVeterinarias out/promo-veterinarias.mp4 && node scripts/finish-render.mjs",
    "stills": "node scripts/render-stills.mjs",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/download-fonts.mjs",
    "audio": "node scripts/render-audio.mjs",
    "check": "node scripts/check-audio.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
